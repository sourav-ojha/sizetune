{
  // Static-only Worker: no "main", no bindings. Cloudflare serves ./dist as static assets (free, unlimited requests).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sizetune",
  "compatibility_date": "2026-11-12",
  // HUMAN-GATED: nothing is deployed or attached until a person connects the repo / runs a deploy.
  // Custom domain (apex). With `routes` present, workers.dev defaults to off; stated explicitly for clarity.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sizetune.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Non-production: `wrangler deploy --env staging` publishes a separate Worker "sizetune-staging" on its own
  // *.workers.dev URL (no custom domain). `routes: []` is required: routes ARE inherited, and without it staging would take sizetune.com.
  // public/_headers already sends X-Robots-Tag: noindex for *.workers.dev hosts.
  "env": {
    "staging": {
      "name": "sizetune-staging",
      "routes": [],
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
