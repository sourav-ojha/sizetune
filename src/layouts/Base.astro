---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  /** Path starting with "/" and ending with "/" – canonical is built from astro.config `site`. */
  path: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Drives build gates (scripts/verify-html.mjs): home | tool | guide | policy | error */
  pageType: 'home' | 'tool' | 'guide' | 'policy' | 'error';
  /** Open Graph type: "article" for guides, "website" for everything else. */
  ogType?: 'website' | 'article';
}
const { title, description, path, jsonLd, noindex = false, pageType, ogType = 'website' } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-default.png', Astro.site).href;
const ogImageAlt = 'SizeTune: resize an image to a size in KB, in your browser';
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/resize-image-to-20kb/', label: '20 KB' },
  { href: '/resize-signature/', label: 'Signature' },
  { href: '/guides/photo-size-for-online-forms/', label: 'Guide' },
  { href: '/about/', label: 'About' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="SizeTune" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body data-page-type={pageType} class="mx-auto max-w-3xl px-4 py-6 text-slate-900">
    <a href="#main" class="sr-only focus:not-sr-only focus:underline">Skip to main content</a>
    <header class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <a href="/" class="text-xl font-bold">SizeTune</a>
      <nav aria-label="Main" class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {navItems.map((n) => (
          <a href={n.href} class="underline-offset-2 hover:underline" aria-current={n.href === path ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="mt-12 border-t pt-4 text-sm text-slate-600">
      <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-1">
        {navItems.map((n) => (
          <a href={n.href} class="underline">{n.label}</a>
        ))}
      </nav>
      <p class="mt-3">SizeTune is a free image resizer. Your images are processed in your browser.</p>
    </footer>
  </body>
</html>
