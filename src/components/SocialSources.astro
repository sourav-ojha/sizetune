---
import { PLATFORMS, PRESETS } from '../data/socialPresets';
import { SOURCES } from '../data/socialSources';
// Server-rendered only: this is where the official URLs live, so tool pages stay free of third-party links.
const ids = [...new Set(PRESETS.map((p) => p.source.id))];
---
<div class="space-y-8">
  {PLATFORMS.map((pl) => (
    <section>
      <h2 class="mt-12 scroll-mt-6 text-2xl font-bold text-slate-950">{pl.name}</h2>
      {ids.filter((id) => PRESETS.some((p) => p.platform === pl.id && p.source.id === id)).map((id) => (
        <div id={id} class="mt-4 scroll-mt-6 rounded-2xl border border-slate-200 bg-white p-5">
          <p class="font-semibold text-slate-950">
            <a class="font-medium text-teal-800 underline underline-offset-4" href={SOURCES[id].url} target="_blank" rel="noopener noreferrer">{SOURCES[id].title}<span class="sr-only"> (opens in a new tab)</span></a>
          </p>
          <ul class="mt-3 list-disc space-y-1.5 pl-6 text-slate-700">
            {PRESETS.filter((p) => p.source.id === id).map((p) => (
              <li><strong>{p.label}, {p.width} × {p.height} px.</strong> {p.note} Last checked {p.checkedOn}.</li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</div>
