---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publisherLd } from '../_seo';
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content, headings } = await render(g);
const toc = headings.filter((h) => h.depth === 2);
const path = `/guides/${g.id}/`;
// First-publication dates per guide (the content schema only carries `updated`).
const published: Record<string, string> = { 'photo-size-for-online-forms': '2026-11-12' };
const modified = g.data.updated.toISOString().slice(0, 10);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.data.title,
  description: g.data.description,
  datePublished: published[g.id] ?? modified,
  dateModified: modified,
  mainEntityOfPage: new URL(path, Astro.site).href,
  author: publisherLd,
  publisher: publisherLd,
  inLanguage: 'en',
};
---
<Base pageType="guide" ogType="article" title={`${g.data.title} | SizeTune`} description={g.data.description} path={path} jsonLd={jsonLd}>
  <article class="space-y-4 text-[1.0625rem] leading-relaxed text-slate-700 [&_h2]:mt-12 [&_h2]:scroll-mt-6 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-slate-950 sm:[&_h2]:text-[1.75rem] [&_a]:font-medium [&_a]:text-teal-800 [&_a]:underline [&_a]:underline-offset-4 [&_ol]:list-decimal [&_ol]:space-y-1.5 [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-6 [&_li]:marker:text-teal-700 [&_em]:text-slate-600">
    <h1 class="text-4xl font-bold leading-[1.1] tracking-tight text-slate-950">{g.data.title}</h1>
    {toc.length > 1 && (
      <nav aria-label="In this guide" class="rounded-2xl border border-slate-200 bg-white p-5 text-base">
        <p class="font-bold text-slate-950">In this guide</p>
        <ol class="mt-1 space-y-0 !pl-5 leading-loose text-slate-700">
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <Content />
    <div class="!mt-12 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-teal-700 p-6 text-white">
      <div class="min-w-0 flex-1 basis-72">
        <p class="text-xl font-bold">Ready to try it?</p>
        <p class="mt-1 text-teal-50">Pick your limit, drop your photo, download. Nothing leaves your device.</p>
      </div>
      <a href="/" class="!text-teal-900 !no-underline inline-flex min-h-12 items-center rounded-xl bg-white px-6 font-bold hover:bg-teal-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Resize an image</a>
    </div>
  </article>
</Base>
