{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "growth-strategy records (.growth/*.json). Semantic rules (sources exist, metric provenance, dates, lifecycle) are enforced by core/scripts/lib/evidence.mjs.",
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "category",
        "audience",
        "goals",
        "geographies",
        "languages",
        "monetization",
        "constraints"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "geographies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "minItems": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "minItems": 1
        },
        "monetization": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "product_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "accessed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S-\\d{3,}$"
        },
        "type": {
          "enum": [
            "serp",
            "competitor",
            "documentation",
            "community",
            "directory",
            "tool-export",
            "gsc",
            "analytics",
            "user",
            "repo",
            "web"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 500
        },
        "ref": {
          "type": "string",
          "pattern": "^(repo|file|user|tool):",
          "maxLength": 300
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "geo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "kind",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "kind": {
          "enum": [
            "measured",
            "estimate",
            "unknown"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^S-\\d{3,}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyword",
        "cluster",
        "intent",
        "geo",
        "volume",
        "difficulty",
        "priority",
        "evidence",
        "confidence",
        "sources",
        "researched"
      ],
      "properties": {
        "keyword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "cluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "intent": {
          "enum": [
            "informational",
            "navigational",
            "commercial",
            "transactional",
            "unknown"
          ]
        },
        "geo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "volume": {
          "$ref": "#/$defs/metric"
        },
        "difficulty": {
          "$ref": "#/$defs/metric"
        },
        "cpc": {
          "$ref": "#/$defs/metric"
        },
        "serp_notes": {
          "type": "string",
          "maxLength": 500
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "target_page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "evidence": {
          "enum": [
            "fact",
            "inference",
            "estimate",
            "hypothesis",
            "assumption",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S-\\d{3,}$"
          }
        },
        "researched": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "performance": {
          "type": "object"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "rationale",
        "keywords",
        "sources",
        "evidence",
        "confidence",
        "impact",
        "effort",
        "window",
        "owner",
        "risks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GRO-\\d{3,}$"
        },
        "type": {
          "enum": [
            "landing-page",
            "content",
            "technical-seo",
            "internal-linking",
            "distribution",
            "measurement",
            "monetization"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S-\\d{3,}$"
          }
        },
        "evidence": {
          "enum": [
            "fact",
            "inference",
            "estimate",
            "hypothesis",
            "assumption",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "impact": {
          "enum": [
            "H",
            "M",
            "L"
          ]
        },
        "effort": {
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "window": {
          "enum": [
            "weeks 1-4",
            "weeks 5-8",
            "weeks 9-13"
          ]
        },
        "owner": {
          "enum": [
            "implementer",
            "human"
          ]
        },
        "needs_design": {
          "type": "boolean"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "deferred",
            "needs-research",
            "handed-off",
            "done",
            "superseded"
          ]
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^GRO-\\d{3,}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "findings",
        "plan_hash"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "PASS WITH CHANGES",
            "FAIL"
          ]
        },
        "checked_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S-\\d{3,}$"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "type",
              "summary"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "Critical",
                  "High",
                  "Medium",
                  "Low"
                ]
              },
              "item": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^GRO-\\d{3,}$"
              },
              "type": {
                "enum": [
                  "evidence",
                  "fabricated-metric",
                  "cannibalization",
                  "thin-content",
                  "expectations",
                  "effort",
                  "actionability",
                  "distribution-risk",
                  "other"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "fix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            }
          }
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
